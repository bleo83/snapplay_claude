# API server-only configuration — never expose or commit real values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local behavior
SNAPPLAY_DEMO_MODE=true
SNAPPLAY_API_PORT=4000
SNAPPLAY_PUBLIC_BASE_URL=http://localhost:4000
SNAPPLAY_BACKOFFICE_URL=http://localhost:3000
SNAPPLAY_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Webhook signing secrets are references in production; this literal is local-only.
RAPPI_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# CLI-only values; keep these in a local shell or untracked file.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
