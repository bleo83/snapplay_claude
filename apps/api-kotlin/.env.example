# Snap Play API — copy to .env for local overrides
# docker compose up works out of the box without this file.
# Use .env only when running the JAR directly (without Docker Compose).

# Database
SNAPPLAY_DB_URL=jdbc:postgresql://localhost:5433/snapplay  # port 5433 = docker-compose postgres host port
SNAPPLAY_DB_USER=snapplay
SNAPPLAY_DB_PASSWORD=snapplay

# URLs
SNAPPLAY_PUBLIC_BASE_URL=http://localhost:8080
SNAPPLAY_BACKOFFICE_URL=http://localhost:3000
SNAPPLAY_ALLOWED_ORIGINS=http://localhost:3000

# Webhook secret (local placeholder — replace in production)
RAPPI_WEBHOOK_SECRET=local-dev-secret-replace-in-production

# OAuth2 / Supabase JWT (leave empty to skip JWT validation in local dev)
SNAPPLAY_SUPABASE_JWKS_URI=
